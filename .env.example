# ==========================================
# DETECTIVE AI - Variáveis de Ambiente
# ==========================================

# Chave de API da OpenAI (obrigatória para respostas reais dos NPCs via LLM)
OPENAI_API_KEY=sua-chave-openai-aqui

# Provedor de IA dos NPCs: "openai" para LLM real, ou "dummy" para testes locais determinísticos sem custos
NPC_AI_PROVIDER=openai

# Modelo da OpenAI utilizado para interpretar as falas dos NPCs
OPENAI_MODEL=gpt-5-mini

# Provedor do classificador semântico de mensagens: "heuristic" (default) ou "openai"
MESSAGE_CLASSIFIER_PROVIDER=heuristic

# Modelo da OpenAI para classificação semântica (quando MESSAGE_CLASSIFIER_PROVIDER=openai)
OPENAI_CLASSIFIER_MODEL=gpt-5-mini

# Ativar logs detalhados de trace de turno
DEBUG_TURN_TRACE=false
